{
  "migration_id": "migration-ms2-aws-to-azure-001",
  "microservice": {
    "id": "ms2",
    "name": "ms2-composite",
    "container": {
      "image": "ms2-composite:1.0.0",
      "port": 8082,
      "environment": {
        "APP_PROVIDER": "azure",
        "APP_MS_NAME": "ms2"
      }
    },
    "health_check": {
      "path": "/health",
      "port": 8082
    },
    "dependencies": [
      {
        "service_id": "ms3",
        "protocol": "http",
        "port": 8083,
        "required": true
      }
    ]
  },
  "source": {
    "provider": "aws",
    "region": "us-east-1",
    "environment": "source",
    "credentials_ref": "secret/ms2/source"
  },
  "target": {
    "provider": "azure",
    "region": "eastus",
    "environment": "target",
    "credentials_ref": "secret/ms2/target"
  },
  "data": {
    "type": "postgresql",
    "source": {
      "host": "postgres-ms2",
      "port": 5432,
      "database": "ms2_db",
      "credentials_ref": "secret/ms2/database/source"
    },
    "target": {
      "host": "target-db",
      "port": 5432,
      "database": "ms2_db",
      "credentials_ref": "secret/ms2/database/target"
    }
  }
}
